include module

doctype html
html
	head
		title= L('title')
		+PageHead()
	body.login-page
		span#locale= JSON.stringify(LANG)

		header.login-header
			div.login-header-inner
				a.login-brand-link(href='/')
					img.login-header-logo(src='/img/kkutu/short_logo.png', alt='파얼끄투')
				nav.login-nav
					a(href='/') 홈
					a(href='/legal/copyright') 저작권 안내
					a(href='/legal/word-sources') 단어 출처 안내
					a(href='/tos.html#terms') 이용약관

		main.login-main
			section.login-panel
				h1 파얼끄투 로그인
				p.login-desc 게임을 시작하려면 계정으로 로그인해 주세요.
				div.login-with= locals.text ? L(locals.text) : L('loginWith')
				div.login-provider-list
					each val in loginList
						- var brandImage = "/img/login/" + val.vendor + ".svg"
						- if(val.vendor === "naver") brandImage = "/img/login/naver.png"
						- if(val.vendor === "discord") brandImage = "/img/login/discord.svg"
						- if(val.vendor === "roblox") brandImage = "/img/login/roblox-white.svg"
						- if(val.vendor === "google") brandImage = "/img/login/google.png"
						- if(val.vendor === "kakao") brandImage = "/img/login/kakao.svg"
						a.login-provider(href="/login/" + val.vendor, class="login-provider-" + val.vendor, style="color: " + val.fontColor + "; background-color: " + val.color + ";")
							div.login-provider-icon-wrap
								img.login-provider-icon(src=brandImage, alt=val.vendor, onerror="this.onerror=null;this.src='/img/login/' + this.alt + '.svg';")
							div.login-provider-label= L(val.displayName)

		footer.login-footer
			div.login-footer-inner
				div.login-footer-left
					strong 파얼끄투
					span 비영리 끄투 프리서버
				div.login-footer-right
					a(href='/tos.html#terms') 서비스 이용약관
					a(href='/tos.html#privacy') 개인정보 처리방침
